APP_NAME="FORMÉ"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@shopforme.net"
MAIL_FROM_NAME="FORMÉ"
ADMIN_NOTIFICATION_EMAIL=hello@shopforme.net

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Store contact details shown on the site and in emails
STORE_EMAIL=hello@shopforme.net
STORE_WHATSAPP_DISPLAY="+234 702 612 6265"
STORE_WHATSAPP_NUMBER=2347026126265

# Paystack (test keys locally, live keys in production)
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
VITE_PAYSTACK_PUBLIC_KEY="${PAYSTACK_PUBLIC_KEY}"

# Routely delivery
ROUTELY_ENV=test
ROUTELY_API_KEY=
ROUTELY_BASE_URL=https://server.routely.co/api
ROUTELY_SENDER_NAME="FORMÉ Lagos"
ROUTELY_SENDER_PHONE=
ROUTELY_SENDER_EMAIL=hello@shopforme.net
ROUTELY_SENDER_ADDRESS="Lekki Phase 1, Lagos"
ROUTELY_SENDER_CITY=Lekki
ROUTELY_SENDER_STATE=Lagos
ROUTELY_SENDER_COORDINATES="6.4426,3.4833"
